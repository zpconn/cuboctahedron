theorem evalLabelStepFn_exists_of_closedDAGSuffixOk
    {state : Nat} {labels : List Face}
    (h : ClosedDAGSuffixOk state labels) :
    exists finish gain,
      evalLabelStepFn closedDAGNext state labels = some (finish, gain) := by
